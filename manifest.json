{
    "manifest_version": 3,
    "name": "Youtube Music Pop-up",
    "version": "1.0.1",

    "description": "Allows you to Play/Pause/Play next/Play previous from another tab",

    "permissions": ["tabs"],

    "host_permissions": ["*://music.youtube.com/*"],

    "icons": {
        "48": "images/image.png"
    },

    "action": {
        "default_icon": "images/image.png",
        "default_popup": "src/menu.html",
        "default_title": "Youtube Music Pop-up"
    },

    "content_scripts": [
        {
            "matches": ["*://music.youtube.com/*"],
            "js": ["content.js"]
        }
    ],
    
    "browser_specific_settings": {
	"gecko": {
	    "id": "ytmusic-popup@oscar",
	    "strict_min_version": "140.0",
	    "data_collection_permissions": {
		"required": ["none"]
	    }
        },
	"gecko_android": {
	    "strict_min_version": "142.0"
	}
    }
}
